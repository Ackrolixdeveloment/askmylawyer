# Backend base URL (server-side only — the browser calls this app's /api/v1/*).
# Optional: without it, `next dev` uses http://localhost:4000 and a
# production build uses https://api.amlst.in (see src/lib/api-origin.ts).
# Set it to override either, e.g. a tunnel: https://<id>-4000.inc1.devtunnels.ms
# API_URL=http://localhost:4000
