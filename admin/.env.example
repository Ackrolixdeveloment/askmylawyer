# Backend base URL (server-side only — the browser calls this app's /api/v1/*).
# Optional: without it the app uses the development tunnel in next.config.ts.
# Local: http://localhost:4000 (or a forwarded tunnel, e.g.
# https://<id>-4000.inc1.devtunnels.ms)   On Amplify: the EC2 API URL.
API_URL=http://localhost:4000
