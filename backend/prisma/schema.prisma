generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  active
  inactive
}

/// App accounts: customers and lawyers share one users table.
enum AppRole {
  customer
  lawyer
}

enum UserStatus {
  active
  suspended
}

/// Where a device token came from.
enum DevicePlatform {
  android
  ios
}

/// Where a scheduled broadcast has got to.
enum ScheduledStatus {
  scheduled
  sent
  cancelled
  failed
}

/// Who a broadcast went to.
enum NotificationAudience {
  all_lawyers
  all_customers
  lawyer
  customer
}

enum OnboardingStatus {
  draft
  submitted
  in_review
  correction_requested
  resubmitted
  approved
  rejected
}

enum OtpChannel {
  sms
  email
}

enum AuthProvider {
  google
  apple
}

model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  role               AppRole
  /// E.164, e.g. +919876543210. Empty for accounts created via email/Google/Apple.
  phone              String?                 @db.VarChar(15)
  /// Always stored lowercase.
  email              String?                 @db.VarChar(255)
  emailVerifiedAt    DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  fullName           String?                 @map("full_name") @db.VarChar(150)
  /// Sequential, lawyers only — shown as "LAW0001". See lawyer_number_seq.
  lawyerNumber       Int?                    @unique @map("lawyer_number")
  status             UserStatus              @default(active)
  suspendedAt        DateTime?               @map("suspended_at") @db.Timestamptz(6)
  /// Shown to the lawyer when the app signs them out.
  suspensionReason   String?                 @map("suspension_reason") @db.VarChar(500)
  lastLoginAt        DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz(6)
  lawyerProfile      LawyerProfile?
  bankAccount        LawyerBankAccount?
  documents          LawyerDocument[]
  sessions           UserSession[]
  identities         AuthIdentity[]
  editRequests       LawyerEditRequest[]
  deviceTokens       DeviceToken[]
  inbox              UserNotification[]
  adminNotifications AdminNotification[]
  alerts             AdminAlert[]
  scheduled          ScheduledNotification[]
  pushTokens         AdminPushToken[]

  /// The same phone/email may hold one account per role (see ALLOW_MULTI_ROLE_PHONE).
  @@unique([phone, role])
  @@unique([email, role])
  @@map("users")
}

/// A Google or Apple account linked to a user.
model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  /// The provider's stable user id (`sub` claim).
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  role           AppRole
  email          String?      @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerUserId, role])
  @@index([userId])
  @@map("auth_identities")
}

enum KycMethod {
  manual
  digilocker
}

enum LawyerDocumentType {
  aadhaar
  pan
  bar_certificate
  bank_proof
  profile_photo
  signature
}

model LawyerProfile {
  userId           String           @id @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingStatus OnboardingStatus @default(draft) @map("onboarding_status")

  // Step 2 — KYC. Aadhaar is stored encrypted; only the last 4 digits are readable.
  kycMethod          KycMethod? @map("kyc_method")
  aadhaarNumberEnc   String?    @map("aadhaar_number_enc")
  aadhaarLast4       String?    @map("aadhaar_last4") @db.VarChar(4)
  panNumber          String?    @map("pan_number") @db.VarChar(10)
  residentialAddress String?    @map("residential_address") @db.VarChar(500)

  // Step 3 — Bar Council.
  qualification    String? @db.VarChar(100)
  barCouncilState  String? @map("bar_council_state") @db.VarChar(100)
  enrollmentNumber String? @map("enrollment_number") @db.VarChar(50)

  // Professional profile shown to customers.
  about             String?  @db.VarChar(500)
  experienceBand    String?  @map("experience_band") @db.VarChar(30)
  languages         String[] @default([])
  caseCategories    String[] @default([]) @map("case_categories")
  specialisations   String[] @default([])
  /// Audio / Video / Chat, chosen by the lawyer on their profile.
  consultationTypes String[] @default([]) @map("consultation_types")

  // Admin review outcome.
  reviewedById          String?    @map("reviewed_by_id") @db.Uuid
  reviewedBy            AdminUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  approvedAt            DateTime?  @map("approved_at") @db.Timestamptz(6)
  rejectedAt            DateTime?  @map("rejected_at") @db.Timestamptz(6)
  rejectionReason       String?    @map("rejection_reason") @db.VarChar(1000)
  correctionRequestedAt DateTime?  @map("correction_requested_at") @db.Timestamptz(6)
  /// Feedback per review block, e.g. { "Aadhar Card": "Scan is blurry" }.
  correctionNotes       Json?      @map("correction_notes")
  /// Work in progress on the review screen: which step the admin reached and
  /// the tick / cross (plus draft note) on each block. Cleared once decided.
  reviewProgress        Json?      @map("review_progress")

  personalCompletedAt     DateTime? @map("personal_completed_at") @db.Timestamptz(6)
  kycCompletedAt          DateTime? @map("kyc_completed_at") @db.Timestamptz(6)
  professionalCompletedAt DateTime? @map("professional_completed_at") @db.Timestamptz(6)
  bankCompletedAt         DateTime? @map("bank_completed_at") @db.Timestamptz(6)
  profileCompletedAt      DateTime? @map("profile_completed_at") @db.Timestamptz(6)
  submittedAt             DateTime? @map("submitted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([onboardingStatus])
  @@index([enrollmentNumber])
  @@map("lawyer_profiles")
}

/// Where the lawyer's earnings are paid. The account number is stored encrypted.
model LawyerBankAccount {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  holderName       String   @map("holder_name") @db.VarChar(150)
  accountNumberEnc String   @map("account_number_enc")
  accountLast4     String   @map("account_last4") @db.VarChar(4)
  ifscCode         String   @map("ifsc_code") @db.VarChar(11)
  bankName         String   @map("bank_name") @db.VarChar(100)
  swiftCode        String?  @map("swift_code") @db.VarChar(11)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("lawyer_bank_accounts")
}

enum EditRequestStatus {
  pending
  approved
  rejected
}

/// A change an approved lawyer asked for that an admin has to sign off.
/// Only bank details need this today; the section column keeps it open.
model LawyerEditRequest {
  id      String            @id @default(uuid()) @db.Uuid
  userId  String            @map("user_id") @db.Uuid
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  section String            @db.VarChar(60)
  status  EditRequestStatus @default(pending)

  /// The requested values. Account numbers are encrypted, as they are on the
  /// live record.
  payload Json

  /// The new cancelled cheque, held aside until the change is approved.
  proofKey  String? @map("proof_key")
  proofName String? @map("proof_name") @db.VarChar(255)
  proofMime String? @map("proof_mime") @db.VarChar(100)
  proofSize Int?    @map("proof_size")

  requestedAt DateTime   @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt   DateTime?  @map("decided_at") @db.Timestamptz(6)
  decidedById String?    @map("decided_by_id") @db.Uuid
  decidedBy   AdminUser? @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  /// Why it was turned down, shown to the lawyer.
  feedback    String?    @db.VarChar(1000)

  @@index([status, requestedAt])
  @@index([userId])
  @@map("lawyer_edit_requests")
}

/// Uploaded files (S3 in production). One current file per type.
model LawyerDocument {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LawyerDocumentType
  storageKey   String             @unique @map("storage_key")
  originalName String             @map("original_name") @db.VarChar(255)
  mimeType     String             @map("mime_type") @db.VarChar(100)
  sizeBytes    Int                @map("size_bytes")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, type])
  @@map("lawyer_documents")
}

/// One row per app login; holds the hashed refresh token.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?   @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("user_sessions")
}

/// Login codes sent by SMS or email.
model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  channel    OtpChannel
  /// Phone (E.164) for sms, lowercase address for email.
  target     String     @db.VarChar(255)
  role       AppRole
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([channel, target, role, createdAt])
  @@map("otp_codes")
}

/// A job title for admin users. Module access is set per user, not here.
model Role {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @unique @db.VarChar(100)
  description  String?     @db.VarChar(300)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status       AdminStatus @default(active)
  /// Built-in roles (e.g. Super Admin) cannot be deleted.
  isSystem     Boolean     @default(false) @map("is_system")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  admins       AdminUser[]

  @@index([departmentId])
  @@map("roles")
}

/// A team inside the company: Support, Finance, Operations.
model Department {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  /// Short code shown in the table, e.g. "SUP".
  code        String           @unique @db.VarChar(20)
  description String?          @db.VarChar(300)
  status      AdminStatus      @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       Role[]
  categories  TicketCategory[]

  @@map("departments")
}

/// What a support ticket or complaint is about, e.g. "Payment failed".
model TicketCategory {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(120)
  departmentId String      @map("department_id") @db.Uuid
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  status       AdminStatus @default(active)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("ticket_categories")
}

model AdminUser {
  id                     String                  @id @default(uuid()) @db.Uuid
  employeeCode           String                  @unique @map("employee_code") @db.VarChar(20)
  name                   String                  @db.VarChar(150)
  /// Always stored lowercase.
  email                  String                  @unique @db.VarChar(255)
  phone                  String?                 @db.VarChar(15)
  passwordHash           String                  @map("password_hash")
  roleId                 String                  @map("role_id") @db.Uuid
  role                   Role                    @relation(fields: [roleId], references: [id])
  status                 AdminStatus             @default(active)
  /// Module access for this person: { "lawyers": "full", "lawyers.view": "read" }.
  /// Set per user, not inherited from the role.
  permissions            Json?
  failedLoginCount       Int                     @default(0) @map("failed_login_count")
  lockedUntil            DateTime?               @map("locked_until") @db.Timestamptz(6)
  lastLoginAt            DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(6)
  sessions               AdminSession[]
  reviewedLawyers        LawyerProfile[]
  decidedEdits           LawyerEditRequest[]
  adminNotifications     AdminNotification[]
  adminAlerts            AdminAlert[]
  adminPushTokens        AdminPushToken[]
  scheduledNotifications ScheduledNotification[]

  @@index([roleId])
  @@map("admin_users")
}

/// One row per login; holds the hashed refresh token.
model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @map("admin_user_id") @db.Uuid
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?   @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adminUserId])
  @@map("admin_sessions")
}

/// A phone this person is signed in on, so push can reach them.
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The FCM registration token. Belongs to one install, and moves between
  /// accounts when someone else signs in on the same phone.
  token      String         @unique @db.VarChar(255)
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("device_tokens")
}

/// A notification an admin sent, kept as the record of what went out.
model AdminNotification {
  id           String               @id @default(uuid()) @db.Uuid
  title        String               @db.VarChar(120)
  body         String               @db.VarChar(500)
  audience     NotificationAudience
  /// Set when the notification went to one person rather than everyone.
  targetUserId String?              @map("target_user_id") @db.Uuid
  target       User?                @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  /// Devices it was addressed to, and how the send went.
  recipients   Int                  @default(0)
  delivered    Int                  @default(0)
  failed       Int                  @default(0)
  sentById     String?              @map("sent_by_id") @db.Uuid
  sentBy       AdminUser?           @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentAt       DateTime             @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@index([sentAt])
  @@map("admin_notifications")
}

/// What a lawyer or customer sees behind the bell icon in the app.
model UserNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(500)
  /// Where it came from, e.g. "admin_notification".
  type      String    @default("admin_notification") @db.VarChar(40)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("user_notifications")
}

/// What the bell in the admin panel shows: something happened that this
/// admin should look at. One row per recipient, so read state is personal.
model AdminAlert {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(150)
  body        String    @db.VarChar(400)
  /// The permission module it belongs to, e.g. "lawyers".
  module      String    @db.VarChar(40)
  /// Where clicking it goes, e.g. "/lawyers/onboarding/new".
  link        String?   @db.VarChar(300)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?   @db.Uuid

  @@index([adminUserId, createdAt])
  @@map("admin_alerts")
}

/// A browser an admin is signed in on, so the bell can also arrive as a
/// desktop notification when the panel is closed.
model AdminPushToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// The FCM registration token for that browser.
  token       String    @unique @db.VarChar(255)
  userAgent   String?   @map("user_agent") @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?   @db.Uuid

  @@index([adminUserId])
  @@map("admin_push_tokens")
}

/// A notification queued for later. A worker sends it when its time comes.
model ScheduledNotification {
  id           String               @id @default(uuid()) @db.Uuid
  title        String               @db.VarChar(120)
  body         String               @db.VarChar(500)
  audience     NotificationAudience
  /// Set when it goes to one person rather than everyone.
  targetUserId String?              @map("target_user_id") @db.Uuid
  target       User?                @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  scheduledFor DateTime             @map("scheduled_for") @db.Timestamptz(6)
  status       ScheduledStatus      @default(scheduled)
  /// Filled in once it has gone out.
  sentAt       DateTime?            @map("sent_at") @db.Timestamptz(6)
  recipients   Int                  @default(0)
  delivered    Int                  @default(0)
  failed       Int                  @default(0)
  /// Why it could not be sent, when that happens.
  error        String?              @db.VarChar(500)
  createdById  String?              @map("created_by_id") @db.Uuid
  createdBy    AdminUser?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, scheduledFor])
  @@map("scheduled_notifications")
}
