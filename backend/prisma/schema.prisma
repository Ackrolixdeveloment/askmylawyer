generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  active
  inactive
}

/// App accounts: customers and lawyers share one users table.
enum AppRole {
  customer
  lawyer
}

enum UserStatus {
  active
  suspended
}

/// Where a device token came from.
enum DevicePlatform {
  android
  ios
}

/// Where a consultation request has got to.
enum ConsultationStatus {
  /// Waiting on payment, when payment is not being skipped.
  pending_payment
  /// Ringing lawyers.
  searching
  /// A lawyer accepted; the session is set up.
  assigned
  /// The two are connected.
  active
  completed
  cancelled
  /// Nobody accepted in time; the customer chooses refund or reschedule.
  no_lawyer
  refunded
}

/// What one lawyer did with one offer.
enum OfferOutcome {
  ringing
  accepted
  declined
  /// The window closed without an answer.
  expired
  /// Someone else took it first.
  cancelled
}

/// How a consultation request is offered to lawyers.
enum DispatchMode {
  /// Every eligible lawyer is rung at once; first to accept wins.
  broadcast
  /// One lawyer at a time, best first, each with their own window.
  sequential
}

/// Which set of payment gateway keys the platform is using.
enum GatewayEnvironment {
  sandbox
  production
}

/// How the platform's cut of a consultation is worked out.
enum CommissionMode {
  percent
  flat
}

/// Where a scheduled broadcast has got to.
enum ScheduledStatus {
  scheduled
  sent
  cancelled
  failed
}

/// Who a broadcast went to.
enum NotificationAudience {
  all_lawyers
  all_customers
  lawyer
  customer
}

enum OnboardingStatus {
  draft
  submitted
  in_review
  correction_requested
  resubmitted
  approved
  rejected
}

enum OtpChannel {
  sms
  email
}

enum AuthProvider {
  google
  apple
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  role                AppRole
  /// E.164, e.g. +919876543210. Empty for accounts created via email/Google/Apple.
  phone               String?                 @db.VarChar(15)
  /// Always stored lowercase.
  email               String?                 @db.VarChar(255)
  emailVerifiedAt     DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  fullName            String?                 @map("full_name") @db.VarChar(150)
  /// Sequential, lawyers only — shown as "LAW0001". See lawyer_number_seq.
  lawyerNumber        Int?                    @unique @map("lawyer_number")
  status              UserStatus              @default(active)
  suspendedAt         DateTime?               @map("suspended_at") @db.Timestamptz(6)
  /// Shown to the lawyer when the app signs them out.
  suspensionReason    String?                 @map("suspension_reason") @db.VarChar(500)
  lastLoginAt         DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?               @map("deleted_at") @db.Timestamptz(6)
  lawyerProfile       LawyerProfile?
  bankAccount         LawyerBankAccount?
  documents           LawyerDocument[]
  sessions            UserSession[]
  identities          AuthIdentity[]
  editRequests        LawyerEditRequest[]
  deviceTokens        DeviceToken[]
  inbox               UserNotification[]
  presence            LawyerPresence?
  consultations       ConsultationRequest[]   @relation("CustomerConsultations")
  lawyerConsultations ConsultationRequest[]   @relation("LawyerConsultations")
  consultationOffers  ConsultationOffer[]
  adminNotifications  AdminNotification[]
  alerts              AdminAlert[]
  scheduled           ScheduledNotification[]
  pushTokens          AdminPushToken[]

  /// The same phone/email may hold one account per role (see ALLOW_MULTI_ROLE_PHONE).
  @@unique([phone, role])
  @@unique([email, role])
  @@map("users")
}

/// A Google or Apple account linked to a user.
model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  /// The provider's stable user id (`sub` claim).
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  role           AppRole
  email          String?      @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerUserId, role])
  @@index([userId])
  @@map("auth_identities")
}

enum KycMethod {
  manual
  digilocker
}

enum LawyerDocumentType {
  aadhaar
  pan
  bar_certificate
  bank_proof
  profile_photo
  signature
}

model LawyerProfile {
  userId           String           @id @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingStatus OnboardingStatus @default(draft) @map("onboarding_status")

  // Step 2 — KYC. Aadhaar is stored encrypted; only the last 4 digits are readable.
  kycMethod          KycMethod? @map("kyc_method")
  aadhaarNumberEnc   String?    @map("aadhaar_number_enc")
  aadhaarLast4       String?    @map("aadhaar_last4") @db.VarChar(4)
  panNumber          String?    @map("pan_number") @db.VarChar(10)
  residentialAddress String?    @map("residential_address") @db.VarChar(500)

  // Step 3 — Bar Council.
  qualification    String? @db.VarChar(100)
  barCouncilState  String? @map("bar_council_state") @db.VarChar(100)
  enrollmentNumber String? @map("enrollment_number") @db.VarChar(50)

  // Professional profile shown to customers.
  about             String?  @db.VarChar(500)
  experienceBand    String?  @map("experience_band") @db.VarChar(30)
  languages         String[] @default([])
  caseCategories    String[] @default([]) @map("case_categories")
  specialisations   String[] @default([])
  /// Audio / Video / Chat, chosen by the lawyer on their profile.
  consultationTypes String[] @default([]) @map("consultation_types")

  // Admin review outcome.
  reviewedById          String?    @map("reviewed_by_id") @db.Uuid
  reviewedBy            AdminUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  approvedAt            DateTime?  @map("approved_at") @db.Timestamptz(6)
  rejectedAt            DateTime?  @map("rejected_at") @db.Timestamptz(6)
  rejectionReason       String?    @map("rejection_reason") @db.VarChar(1000)
  correctionRequestedAt DateTime?  @map("correction_requested_at") @db.Timestamptz(6)
  /// Feedback per review block, e.g. { "Aadhar Card": "Scan is blurry" }.
  correctionNotes       Json?      @map("correction_notes")
  /// Work in progress on the review screen: which step the admin reached and
  /// the tick / cross (plus draft note) on each block. Cleared once decided.
  reviewProgress        Json?      @map("review_progress")

  personalCompletedAt     DateTime? @map("personal_completed_at") @db.Timestamptz(6)
  kycCompletedAt          DateTime? @map("kyc_completed_at") @db.Timestamptz(6)
  professionalCompletedAt DateTime? @map("professional_completed_at") @db.Timestamptz(6)
  bankCompletedAt         DateTime? @map("bank_completed_at") @db.Timestamptz(6)
  profileCompletedAt      DateTime? @map("profile_completed_at") @db.Timestamptz(6)
  submittedAt             DateTime? @map("submitted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([onboardingStatus])
  @@index([enrollmentNumber])
  @@map("lawyer_profiles")
}

/// Where the lawyer's earnings are paid. The account number is stored encrypted.
model LawyerBankAccount {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  holderName       String   @map("holder_name") @db.VarChar(150)
  accountNumberEnc String   @map("account_number_enc")
  accountLast4     String   @map("account_last4") @db.VarChar(4)
  ifscCode         String   @map("ifsc_code") @db.VarChar(11)
  bankName         String   @map("bank_name") @db.VarChar(100)
  swiftCode        String?  @map("swift_code") @db.VarChar(11)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("lawyer_bank_accounts")
}

enum EditRequestStatus {
  pending
  approved
  rejected
}

/// A change an approved lawyer asked for that an admin has to sign off.
/// Only bank details need this today; the section column keeps it open.
model LawyerEditRequest {
  id      String            @id @default(uuid()) @db.Uuid
  userId  String            @map("user_id") @db.Uuid
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  section String            @db.VarChar(60)
  status  EditRequestStatus @default(pending)

  /// The requested values. Account numbers are encrypted, as they are on the
  /// live record.
  payload Json

  /// The new cancelled cheque, held aside until the change is approved.
  proofKey  String? @map("proof_key")
  proofName String? @map("proof_name") @db.VarChar(255)
  proofMime String? @map("proof_mime") @db.VarChar(100)
  proofSize Int?    @map("proof_size")

  requestedAt DateTime   @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt   DateTime?  @map("decided_at") @db.Timestamptz(6)
  decidedById String?    @map("decided_by_id") @db.Uuid
  decidedBy   AdminUser? @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  /// Why it was turned down, shown to the lawyer.
  feedback    String?    @db.VarChar(1000)

  @@index([status, requestedAt])
  @@index([userId])
  @@map("lawyer_edit_requests")
}

/// Uploaded files (S3 in production). One current file per type.
model LawyerDocument {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LawyerDocumentType
  storageKey   String             @unique @map("storage_key")
  originalName String             @map("original_name") @db.VarChar(255)
  mimeType     String             @map("mime_type") @db.VarChar(100)
  sizeBytes    Int                @map("size_bytes")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, type])
  @@map("lawyer_documents")
}

/// One row per app login; holds the hashed refresh token.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?   @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("user_sessions")
}

/// Login codes sent by SMS or email.
model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  channel    OtpChannel
  /// Phone (E.164) for sms, lowercase address for email.
  target     String     @db.VarChar(255)
  role       AppRole
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([channel, target, role, createdAt])
  @@map("otp_codes")
}

/// A job title for admin users. Module access is set per user, not here.
model Role {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @unique @db.VarChar(100)
  description  String?     @db.VarChar(300)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status       AdminStatus @default(active)
  /// Built-in roles (e.g. Super Admin) cannot be deleted.
  isSystem     Boolean     @default(false) @map("is_system")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  admins       AdminUser[]

  @@index([departmentId])
  @@map("roles")
}

/// A team inside the company: Support, Finance, Operations.
model Department {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  /// Short code shown in the table, e.g. "SUP".
  code        String           @unique @db.VarChar(20)
  description String?          @db.VarChar(300)
  status      AdminStatus      @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       Role[]
  categories  TicketCategory[]

  @@map("departments")
}

/// What a support ticket or complaint is about, e.g. "Payment failed".
model TicketCategory {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(120)
  departmentId String      @map("department_id") @db.Uuid
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  status       AdminStatus @default(active)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([name, departmentId])
  @@index([departmentId])
  @@map("ticket_categories")
}

model AdminUser {
  id                     String                  @id @default(uuid()) @db.Uuid
  employeeCode           String                  @unique @map("employee_code") @db.VarChar(20)
  name                   String                  @db.VarChar(150)
  /// Always stored lowercase.
  email                  String                  @unique @db.VarChar(255)
  phone                  String?                 @db.VarChar(15)
  passwordHash           String                  @map("password_hash")
  roleId                 String                  @map("role_id") @db.Uuid
  role                   Role                    @relation(fields: [roleId], references: [id])
  status                 AdminStatus             @default(active)
  /// Module access for this person: { "lawyers": "full", "lawyers.view": "read" }.
  /// Set per user, not inherited from the role.
  permissions            Json?
  failedLoginCount       Int                     @default(0) @map("failed_login_count")
  lockedUntil            DateTime?               @map("locked_until") @db.Timestamptz(6)
  lastLoginAt            DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(6)
  sessions               AdminSession[]
  reviewedLawyers        LawyerProfile[]
  decidedEdits           LawyerEditRequest[]
  adminNotifications     AdminNotification[]
  adminAlerts            AdminAlert[]
  adminPushTokens        AdminPushToken[]
  scheduledNotifications ScheduledNotification[]
  consultationSettings   ConsultationSettings[]
  settingsAudits         SettingsAudit[]

  @@index([roleId])
  @@map("admin_users")
}

/// One row per login; holds the hashed refresh token.
model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @map("admin_user_id") @db.Uuid
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?   @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adminUserId])
  @@map("admin_sessions")
}

/// A phone this person is signed in on, so push can reach them.
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The FCM registration token. Belongs to one install, and moves between
  /// accounts when someone else signs in on the same phone.
  token      String         @unique @db.VarChar(255)
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("device_tokens")
}

/// A notification an admin sent, kept as the record of what went out.
model AdminNotification {
  id           String               @id @default(uuid()) @db.Uuid
  title        String               @db.VarChar(120)
  body         String               @db.VarChar(500)
  audience     NotificationAudience
  /// Set when the notification went to one person rather than everyone.
  targetUserId String?              @map("target_user_id") @db.Uuid
  target       User?                @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  /// Devices it was addressed to, and how the send went.
  recipients   Int                  @default(0)
  delivered    Int                  @default(0)
  failed       Int                  @default(0)
  sentById     String?              @map("sent_by_id") @db.Uuid
  sentBy       AdminUser?           @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentAt       DateTime             @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@index([sentAt])
  @@map("admin_notifications")
}

/// What a lawyer or customer sees behind the bell icon in the app.
model UserNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(500)
  /// Where it came from, e.g. "admin_notification".
  type      String    @default("admin_notification") @db.VarChar(40)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("user_notifications")
}

/// What the bell in the admin panel shows: something happened that this
/// admin should look at. One row per recipient, so read state is personal.
model AdminAlert {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(150)
  body        String    @db.VarChar(400)
  /// The permission module it belongs to, e.g. "lawyers".
  module      String    @db.VarChar(40)
  /// Where clicking it goes, e.g. "/lawyers/onboarding/new".
  link        String?   @db.VarChar(300)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?   @db.Uuid

  @@index([adminUserId, createdAt])
  @@map("admin_alerts")
}

/// A browser an admin is signed in on, so the bell can also arrive as a
/// desktop notification when the panel is closed.
model AdminPushToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// The FCM registration token for that browser.
  token       String    @unique @db.VarChar(255)
  userAgent   String?   @map("user_agent") @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?   @db.Uuid

  @@index([adminUserId])
  @@map("admin_push_tokens")
}

/// A notification queued for later. A worker sends it when its time comes.
model ScheduledNotification {
  id           String               @id @default(uuid()) @db.Uuid
  title        String               @db.VarChar(120)
  body         String               @db.VarChar(500)
  audience     NotificationAudience
  /// Set when it goes to one person rather than everyone.
  targetUserId String?              @map("target_user_id") @db.Uuid
  target       User?                @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  scheduledFor DateTime             @map("scheduled_for") @db.Timestamptz(6)
  status       ScheduledStatus      @default(scheduled)
  /// Filled in once it has gone out.
  sentAt       DateTime?            @map("sent_at") @db.Timestamptz(6)
  recipients   Int                  @default(0)
  delivered    Int                  @default(0)
  failed       Int                  @default(0)
  /// Why it could not be sent, when that happens.
  error        String?              @db.VarChar(500)
  createdById  String?              @map("created_by_id") @db.Uuid
  createdBy    AdminUser?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, scheduledFor])
  @@map("scheduled_notifications")
}

/// A consultation plan the customer can book: chat, audio or video.
///
/// Priced by the admin team in Settings, and read by both apps — the lawyer
/// picks which of these they take, and the customer picks one to book.
model ServicePlan {
  id               String         @id @default(uuid()) @db.Uuid
  /// Stable key the apps refer to: "audio", "video", "chat".
  code             String         @unique @db.VarChar(30)
  /// What the customer sees, e.g. "Audio Call".
  type             String         @db.VarChar(60)
  /// What the customer pays for the consultation, in rupees.
  amount           Int
  commissionMode   CommissionMode @default(percent) @map("commission_mode")
  /// A percentage (0-100) or a flat fee in rupees, per commissionMode.
  commissionValue  Int            @map("commission_value")
  /// Minutes included before the consultation runs out.
  durationMinutes  Int            @map("duration_minutes")
  /// Length of one paid extension, and what it costs.
  extensionMinutes Int            @map("extension_minutes")
  extensionAmount  Int            @map("extension_amount")
  /// Off hides the plan from the apps without losing its pricing.
  enabled          Boolean        @default(true)
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("service_plans")
}

/// One row, holding the rates that apply to every plan.
model PlatformSettings {
  id         Int                @id @default(1)
  /// Which Cashfree keys the apps are charging through.
  gateway    GatewayEnvironment @default(sandbox)
  /// Added on top of every consultation and extension.
  gstPercent Int                @default(18) @map("gst_percent")
  /// Withheld from the lawyer's earnings and paid to the tax department.
  tdsPercent Int                @default(10) @map("tds_percent")
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

/// Cashfree credentials, one row per environment.
///
/// Both sets are kept so switching between test and live never loses the
/// other one. Secrets are encrypted at rest and never leave the server: the
/// admin panel only ever sees the last four characters.
model PaymentGateway {
  environment      GatewayEnvironment @id
  appId            String?            @map("app_id") @db.VarChar(120)
  secretKeyEnc     String?            @map("secret_key_enc")
  secretKeyLast4   String?            @map("secret_key_last4") @db.VarChar(4)
  webhookSecretEnc String?            @map("webhook_secret_enc")
  webhookLast4     String?            @map("webhook_last4") @db.VarChar(4)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_gateways")
}

/// How the consultation engine behaves: who gets rung, for how long, and
/// what the apps show while it happens.
///
/// One row, read by the engine on every request, so a change here applies to
/// the next consultation without a restart.
model ConsultationSettings {
  id Int @id @default(1)

  /// The whole demo profile in one switch. Shown as a banner in the panel.
  demoMode Boolean @default(false) @map("demo_mode")

  // ---- Matching ----
  dispatchMode             DispatchMode @default(sequential) @map("dispatch_mode")
  /// Demo only: ring every lawyer, whatever their status or preferences.
  ignoreLawyerFilters      Boolean      @default(false) @map("ignore_lawyer_filters")
  /// How long one offer stays on a lawyer's screen.
  ringWindowSeconds        Int          @default(25) @map("ring_window_seconds")
  /// How long to keep searching before giving up.
  searchLimitSeconds       Int          @default(300) @map("search_limit_seconds")
  /// Widening rings, in kilometres.
  radiusStepsKm            Int[]        @default([3, 10, 25]) @map("radius_steps_km")
  /// After this many refusals, ring a few at once. 0 turns it off.
  escalateAfterAttempts    Int          @default(0) @map("escalate_after_attempts")
  /// Breathing space after a consultation before the next offer.
  wrapUpCooldownMinutes    Int          @default(2) @map("wrap_up_cooldown_minutes")
  /// A lawyer is left alone this long before a booked consultation.
  scheduledBufferMinutes   Int          @default(15) @map("scheduled_buffer_minutes")
  /// A position older than this counts as unavailable.
  locationFreshnessMinutes Int          @default(2) @map("location_freshness_minutes")

  // ---- Availability ----
  heartbeatSeconds   Int @default(45) @map("heartbeat_seconds")
  maxConcurrentChat  Int @default(3) @map("max_concurrent_chat")
  maxConcurrentVoice Int @default(1) @map("max_concurrent_voice")
  maxConcurrentVideo Int @default(1) @map("max_concurrent_video")

  // ---- Payments ----
  /// Demo only: connect without taking payment.
  skipPayment     Boolean @default(false) @map("skip_payment")
  /// Refunded automatically if the customer never answers the popup.
  autoRefundHours Int     @default(24) @map("auto_refund_hours")

  // ---- What the customer sees while waiting ----
  showNotifiedCount       Boolean @default(true) @map("show_notified_count")
  allowCancelDuringSearch Boolean @default(true) @map("allow_cancel_during_search")

  // ---- Session ----
  /// How long a call token stays valid past the plan's duration.
  tokenGraceMinutes Int @default(10) @map("token_grace_minutes")
  /// A dropped call is closed after this long without a reconnect.
  callGraceSeconds  Int @default(60) @map("call_grace_seconds")

  updatedById String?    @map("updated_by_id") @db.Uuid
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("consultation_settings")
}

/// Who changed a setting, and what they changed.
model SettingsAudit {
  id        String     @id @default(uuid()) @db.Uuid
  /// Which screen it came from, e.g. "consultation-engine".
  area      String     @db.VarChar(40)
  /// { field: { from, to } } for everything that actually changed.
  changes   Json
  actorId   String?    @map("actor_id") @db.Uuid
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([area, createdAt])
  @@map("settings_audit")
}

/// Where a lawyer is, and whether they are taking consultations.
///
/// One row per lawyer, rewritten by their heartbeat. The engine reads it to
/// decide who can be rung.
model LawyerPresence {
  userId         String    @id @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline       Boolean   @default(false) @map("is_online")
  latitude       Float?
  longitude      Float?
  /// Metres, as reported by the phone.
  accuracy       Float?
  /// Consultations in progress, so their limit can be respected.
  activeSessions Int       @default(0) @map("active_sessions")
  /// Set after a consultation ends, so they get a moment before the next.
  busyUntil      DateTime? @map("busy_until") @db.Timestamptz(6)
  lastHeartbeat  DateTime? @map("last_heartbeat_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isOnline, lastHeartbeat])
  @@map("lawyer_presence")
}

/// One customer asking for a consultation, and how the search went.
model ConsultationRequest {
  id              String               @id @default(uuid()) @db.Uuid
  customerId      String               @map("customer_id") @db.Uuid
  customer        User                 @relation("CustomerConsultations", fields: [customerId], references: [id], onDelete: Cascade)
  planCode        String               @map("plan_code") @db.VarChar(30)
  /// What the plan cost when it was booked; prices change, records should not.
  planName        String               @map("plan_name") @db.VarChar(60)
  amount          Int
  durationMinutes Int                  @map("duration_minutes")
  /// What the customer says the matter is about.
  category        String?              @db.VarChar(120)
  description     String?              @db.VarChar(1000)
  /// Where the customer was, for distance-based matching later.
  latitude        Float?
  longitude       Float?
  status          ConsultationStatus   @default(searching)
  /// The lawyer who accepted.
  lawyerId        String?              @map("lawyer_id") @db.Uuid
  lawyer          User?                @relation("LawyerConsultations", fields: [lawyerId], references: [id], onDelete: SetNull)
  /// When the search gives up.
  searchEndsAt    DateTime?            @map("search_ends_at") @db.Timestamptz(6)
  assignedAt      DateTime?            @map("assigned_at") @db.Timestamptz(6)
  /// For a booked consultation, when it should start.
  scheduledFor    DateTime?            @map("scheduled_for") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  offers          ConsultationOffer[]
  session         ConsultationSession?

  @@index([status, searchEndsAt])
  @@index([customerId, createdAt])
  @@map("consultation_requests")
}

/// One lawyer's phone ringing for one request.
model ConsultationOffer {
  id         String              @id @default(uuid()) @db.Uuid
  requestId  String              @map("request_id") @db.Uuid
  request    ConsultationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lawyerId   String              @map("lawyer_id") @db.Uuid
  lawyer     User                @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  outcome    OfferOutcome        @default(ringing)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(6)
  answeredAt DateTime?           @map("answered_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([requestId, lawyerId])
  @@index([outcome, expiresAt])
  @@index([lawyerId, outcome])
  @@map("consultation_offers")
}

/// The call or chat itself.
model ConsultationSession {
  id        String              @id @default(uuid()) @db.Uuid
  requestId String              @unique @map("request_id") @db.Uuid
  request   ConsultationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// The Agora channel both sides join; the request id, so it is unique.
  channel   String              @db.VarChar(64)
  startedAt DateTime?           @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime?           @map("ended_at") @db.Timestamptz(6)
  /// Who hung up: "customer", "lawyer" or "system".
  endedBy   String?             @map("ended_by") @db.VarChar(20)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("consultation_sessions")
}
