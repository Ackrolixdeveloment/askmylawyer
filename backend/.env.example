# ---- App ----
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Local Docker. On AWS, replace with the RDS URL (add ?sslmode=require).
DATABASE_URL=postgresql://aml:aml@localhost:5432/askmylawyer?schema=public

# ---- Admin auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Leave empty until the domain is purchased (e.g. .askmylawyer.com).
COOKIE_DOMAIN=
# true on AWS (HTTPS), false for local http.
COOKIE_SECURE=false

# ---- App (lawyer / customer) auth ----
APP_REFRESH_TOKEN_TTL_DAYS=30
# true = the same phone can have both a lawyer and a customer account.
ALLOW_MULTI_ROLE_PHONE=true

# ---- OTP ----
# true = no SMS is sent and OTP_BYPASS_CODE is accepted for every number.
# Set to false once the MSG91 template is approved.
OTP_BYPASS_ENABLED=true
OTP_BYPASS_CODE=123456
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=20
OTP_MAX_SENDS_PER_HOUR=5

# ---- Email (Resend) ----
# Leave empty locally: emails are printed to the console instead.
RESEND_API_KEY=
# Must be a sender on a domain verified in the Resend dashboard.
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=Ask My Lawyer

# ---- Social login ----
# Comma-separated OAuth client IDs whose Google ID tokens we accept
# (Web/server client ID used by the apps, plus Android/iOS IDs if needed).
GOOGLE_CLIENT_IDS=
# Comma-separated iOS bundle IDs (lawyer app, customer app).
APPLE_CLIENT_IDS=com.askmylawyer.lawyerApp

# ---- Sensitive data ----
# Encrypts Aadhaar and bank account numbers. Generate: openssl rand -base64 32
# Never change it once real data exists (old values could no longer be read).
DATA_ENCRYPTION_KEY=

# ---- File storage ----
# local = files under STORAGE_LOCAL_DIR (development); s3 = AWS S3 (EC2 uses its IAM role).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
AWS_REGION=ap-south-1

# ---- Logging ----
LOG_LEVEL=debug
# pretty locally, json on EC2 (shipped to CloudWatch).
LOG_FORMAT=pretty

# ---- First Super Admin (used by `npm run db:seed`) ----
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@askmylawyer.com
SEED_ADMIN_PASSWORD=Admin@12345
